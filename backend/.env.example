# ==========================================
# VISA FOR NATION - BACKEND ENVIRONMENT CONFIG
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/visa_leads?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/visa_for_nation_leads

# Admin Dashboard Password (Used to log into the Admin UI)
ADMIN_PASSWORD=Admin@Visa2026!

# JWT Secret for Admin Session Tokens
JWT_SECRET=visa_for_nation_super_secret_jwt_key_2026_xyz

# Client URL(s) for CORS (Comma-separated for multiple origins, or * for all)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# ==========================================
# GOOGLE DRIVE CONFIGURATION
# (Files are uploaded to your Google Drive folder)
# ==========================================

# Google Drive Target Folder ID (The ID from folder URL: https://drive.google.com/drive/folders/YOUR_FOLDER_ID)
GOOGLE_DRIVE_FOLDER_ID=

# OPTION 1: Google Service Account (Recommended for automated server uploads)
# Create at https://console.cloud.google.com/ -> IAM & Admin -> Service Accounts
# Share the Google Drive folder with this service account email with "Editor" permission!
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Note: In .env, replace newlines in private key with \n or paste complete key with quotes
GOOGLE_PRIVATE_KEY=

# OPTION 2: Google OAuth2 (Alternative if not using service account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
